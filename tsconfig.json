{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": true,
    "strictNullChecks": true,

    "moduleResolution": "bundler",
    "module": "preserve",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@netlify/*": ["./netlify/*"],
      "@shared/*": ["./types/*"],
      "@db/*": ["./db/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
